DOT_BASE_URL=https://telegram.example.com
DOT_OWNER_ID=REPLACE_WITH_YOUR_TELEGRAM_NUMERIC_ID
DOT_ROOT=/app/runtime
DOT_SEND_ENABLED=false
DOT_BACKGROUND_MONITORING_ENABLED=true
# Optional exact HTTPS Orca webhook URL; its path is a bearer secret.
DOT_ORCA_WEBHOOK_URL=
# Required only when DOT_ORCA_WEBHOOK_URL is set; choose explicitly from collector_status.
DOT_ORCA_WEBHOOK_START_CURSOR=
# Optional comma-separated exact HTTPS OAuth callbacks for other clients.
DOT_OAUTH_REDIRECT_URIS=
